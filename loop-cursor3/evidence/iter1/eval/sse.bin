event: response.output_text.delta
data: {"sequence_number": null, "type": "response.output_text.delta", "delta": " or watch \u2014 applies a constant torque to the first wheel of the gear train. That torque is stepped down through a series of", "message_id": "cursor-live-e12bf07c321247d7b6963c93fff43fc7", "index": 9, "final": false}

