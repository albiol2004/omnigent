+    agent: Agent,
+    agent_cache: AgentCache | None,
+) -> AgentSpec | None:
+    """
+    Load an already-registered agent's trusted root spec.
+
+    The server-loaded bundle is the only trusted source for launch wiring
+    (native permission flags, labels) derived at session create. This is
+    the name trioctl's installer probe imports; it is also the loader
+    :func:`_resolve_subagent_spec` builds on.
+
+    :param agent: The registered agent row, e.g. ``ag_abc123``.
+    :param agent_cache: Cache for loading the parsed bundle. ``None``
+        disables resolution (returns ``None``).
+    :returns: The agent's root :class:`AgentSpec`, or ``None`` when the
+        cache is absent or the bundle fails to load.
+    """
+    if agent_cache is None:
+        return None
+    try:
+        return agent_cache.load(
+            agent.id, agent.bundle_location, expand_env=agent.session_id is None
+        ).spec
+    except Exception:  # noqa: BLE001
+        # A bundle that fails to load here must not break session
+        # creation; the session still works, just without the
+        # derived labels / launch args.
+        _logger.warning(
+            "Could not load bundle for agent %s to derive launch config",
+            agent.id,
+            exc_info=True,
+        )
+        return None
+
