diff --git a/tests/tools/builtins/test_child_reasoning_effort.py b/tests/tools/builtins/test_child_reasoning_effort.py
new file mode 100644
index 000000000..8db9ab1b1
--- /dev/null
+++ b/tests/tools/builtins/test_child_reasoning_effort.py
@@ -0,0 +1,140 @@
+"""``reasoning_effort`` for ``sys_session_create`` child sessions.
+
+Covers the Trio compatibility contract: the orchestrator's
+``sys_session_create`` carries a validated ``reasoning_effort`` into the
+``POST /v1/sessions`` body, rejects an unknown level before any request is
+sent, and the server's create-time validation accepts exactly the same
+vocabulary. Also pins the registered-agent spec loader the trio installer
+probes (``_resolve_agent_spec``).
+"""
+
+from __future__ import annotations
+
+import json
+from types import SimpleNamespace
+from typing import Any
+
+import httpx
+import pytest
+
+from omnigent.errors import OmnigentError
+from omnigent.runner.tool_dispatch import execute_tool
+from omnigent.server.routes._session_create_validation import validate_session_model_metadata
+from omnigent.tools.builtins.spawn import SysSessionCreateTool
+
+
+def _server(posts: list[dict[str, Any]]) -> httpx.AsyncClient:
+    async def _handler(request: httpx.Request) -> httpx.Response:
+        if request.method == "POST" and request.url.path == "/v1/sessions":
+            posts.append(json.loads(request.content))
+            return httpx.Response(
+                201,
+                json={"id": "conv_child", "agent_id": "ag_x", "agent_name": "w", "status": "idle"},
+            )
+        return httpx.Response(404, json={"error": str(request.url)})
+
+    return httpx.AsyncClient(transport=httpx.MockTransport(_handler), base_url="http://server")
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("effort", ["high", "xhigh", "max"])
+async def test_session_create_forwards_reasoning_effort(effort: str) -> None:
+    posts: list[dict[str, Any]] = []
+    async with _server(posts) as client:
+        output = await execute_tool(
+            tool_name="sys_session_create",
+            arguments=json.dumps({"agent_id": "ag_x", "message": "go", "reasoning_effort": effort}),
+            server_client=client,
+            conversation_id="conv_caller",
+        )
+
+    assert len(posts) == 1
+    assert posts[0]["reasoning_effort"] == effort
+    assert posts[0]["parent_session_id"] == "conv_caller"
+    assert json.loads(output)["conversation_id"] == "conv_child"
+
+
+@pytest.mark.asyncio
+async def test_session_create_omits_reasoning_effort_when_unset() -> None:
+    posts: list[dict[str, Any]] = []
+    async with _server(posts) as client:
+        await execute_tool(
+            tool_name="sys_session_create",
+            arguments=json.dumps({"agent_id": "ag_x"}),
+            server_client=client,
+            conversation_id="conv_caller",
+        )
+
+    assert len(posts) == 1
+    assert "reasoning_effort" not in posts[0]
+
+
+@pytest.mark.asyncio
+async def test_session_create_rejects_invalid_reasoning_effort_without_posting() -> None:
+    posts: list[dict[str, Any]] = []
+    async with _server(posts) as client:
+        output = await execute_tool(
+            tool_name="sys_session_create",
+            arguments=json.dumps({"agent_id": "ag_x", "reasoning_effort": "turbo"}),
+            server_client=client,
+            conversation_id="conv_caller",
+        )
+
+    assert posts == []
+    assert "invalid reasoning_effort" in json.loads(output)["error"]
+
+
+@pytest.mark.asyncio
+async def test_session_create_config_path_refuses_reasoning_effort(tmp_path: Any) -> None:
+    posts: list[dict[str, Any]] = []
+    async with _server(posts) as client:
+        output = await execute_tool(
+            tool_name="sys_session_create",
+            arguments=json.dumps({"config_path": "helper.yaml", "reasoning_effort": "high"}),
+            server_client=client,
+            conversation_id="conv_caller",
+            runner_workspace=tmp_path,
+        )
+
+    assert posts == []
+    assert "reasoning_effort" in json.loads(output)["error"]
+
+
+def test_session_create_schema_advertises_reasoning_effort() -> None:
+    props = SysSessionCreateTool().get_schema()["function"]["parameters"]["properties"]
+    assert "reasoning_effort" in props
+    assert "high" in props["reasoning_effort"]["enum"]
+
+
+def test_server_create_validation_applies_effort_to_child_session() -> None:
+    # ``POST /v1/sessions`` runs this validator and persists its result as the
+    # child's ``reasoning_effort``.
+    assert validate_session_model_metadata(model_override=None, reasoning_effort="high") == (
+        None,
+        "high",
+    )
+    with pytest.raises(OmnigentError, match="invalid reasoning_effort"):
+        validate_session_model_metadata(model_override=None, reasoning_effort="turbo")
+
+
+def test_resolve_agent_spec_loads_registered_agent_root_spec() -> None:
+    from omnigent.server.routes._sessions.helpers import _resolve_agent_spec
+
+    spec = object()
+    loads: list[tuple[str, str | None, bool]] = []
+
+    class _Cache:
+        def load(self, agent_id: str, bundle: str | None, *, expand_env: bool) -> Any:
+            loads.append((agent_id, bundle, expand_env))
+            return SimpleNamespace(spec=spec)
+
+    agent = SimpleNamespace(id="ag_x", bundle_location="loc", session_id=None)
+    assert _resolve_agent_spec(agent=agent, agent_cache=_Cache()) is spec  # type: ignore[arg-type]
+    assert loads == [("ag_x", "loc", True)]
+    assert _resolve_agent_spec(agent=agent, agent_cache=None) is None  # type: ignore[arg-type]
+
+
+def test_resolve_agent_spec_is_importable_from_sessions_package() -> None:
+    from omnigent.server.routes.sessions import _resolve_agent_spec
+
+    assert callable(_resolve_agent_spec)
